{
  "name": "flatkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The open language, compiler and player for the FlatInk animation format.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check:english": "node scripts/check-english.mjs",
    "check:pack": "pnpm build && node scripts/check-pack.mjs",
    "check:size": "node scripts/check-size.mjs",
    "size": "pnpm -C packages/player build && node scripts/check-size.mjs",
    "bench": "node --import tsx packages/player/bench/render.bench.mts",
    "verify": "pnpm run lint && pnpm run check:english && pnpm run typecheck && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "publint": "^0.3.24",
    "skia-canvas": "^4.0.0-rc7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "skia-canvas"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "minimatch>brace-expansion": ">=5.0.12",
      "express-rate-limit>ip-address": ">=10.3.1",
      "ajv>fast-uri": ">=4.1.3",
      "postcss>nanoid": ">=3.3.17"
    }
  }
}
